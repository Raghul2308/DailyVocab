# Copy this file to application-local.properties and fill in your values.
# application-local.properties is gitignored and will NOT be committed.

# Gmail sender account
MAIL_USERNAME=your-gmail@gmail.com
# Gmail App Password (generate at https://myaccount.google.com/apppasswords)
MAIL_PASSWORD=your-16-char-app-password

# Recipient emails (comma-separated)
MAIL_RECIPIENT=recipient1@gmail.com,recipient2@gmail.com

# Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Only needed if deploying; default is http://localhost:8080
APP_BASE_URL=http://localhost:8080
